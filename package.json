{
  "name": "vite-deploy-continuity",
  "version": "0.2.0",
  "description": "Keeps open tabs working after redeploys by retaining prior Vite assets and recovering stale dynamic imports.",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./retention": {
      "types": "./src/retention.d.ts",
      "import": "./src/retention.js"
    },
    "./recovery": {
      "types": "./src/recovery.d.ts",
      "import": "./src/recovery.js"
    },
    "./static": {
      "types": "./src/static.d.ts",
      "import": "./src/static.js"
    }
  },
  "bin": {
    "vite-retain-assets": "bin/vite-retain-assets.js"
  },
  "files": [
    "bin",
    "src",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"bin/**/*.js\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95",
    "lint": "node --check src/*.js bin/*.js test/*.js e2e/*.js scripts/*.mjs playwright.config.js",
    "typecheck": "tsc --project tsconfig.json",
    "package:lint": "publint",
    "package:types": "node scripts/check-package-types.mjs",
    "package:smoke": "node scripts/verify-package.mjs",
    "check": "npm run lint && npm test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run package:lint && npm run package:types && npm run package:smoke",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "vite",
    "dynamic-import",
    "code-splitting",
    "chunk-loading",
    "deployment",
    "static-hosting",
    "asset-versioning",
    "cache-busting",
    "precompressed-assets",
    "spa",
    "frontend-tooling"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Sumin Lim <lim@limsumin.com> (https://limsumin.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoulpro/vite-deploy-continuity.git"
  },
  "bugs": {
    "url": "https://github.com/seoulpro/vite-deploy-continuity/issues"
  },
  "homepage": "https://github.com/seoulpro/vite-deploy-continuity#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "license": "MIT"
}
